# PostgreSQL
POSTGRES_DB=docuflow
POSTGRES_USER=docuflow_user
POSTGRES_PASSWORD=local_dev_db_password

# RabbitMQ
RABBITMQ_DEFAULT_USER=docuflow_user
RABBITMQ_DEFAULT_PASS=local_dev_rabbit_password

# MinIO
MINIO_ROOT_USER=docuflow_admin
MINIO_ROOT_PASSWORD=local_dev_minio_password_123
MINIO_BUCKET=docuflow-documents

DATABASE_URL=postgresql+asyncpg://docuflow_user:local_dev_db_password@localhost:5432/docuflow
